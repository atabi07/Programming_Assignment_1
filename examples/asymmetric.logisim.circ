<project source="3.9.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <main name="main"/>
  <circuit name="main">
    <comp lib="0" loc="(100,100)" name="Pin"><a name="label" val="A"/></comp>
    <comp lib="0" loc="(100,200)" name="Pin"><a name="label" val="B"/></comp>
    <comp lib="1" loc="(240,200)" name="NOT Gate"/>
    <comp lib="1" loc="(400,150)" name="AND Gate"/>
    <comp lib="0" loc="(500,150)" name="Pin">
      <a name="label" val="Y"/><a name="output" val="true"/>
    </comp>
    <wire from="(100,100)" to="(250,100)"/>
    <wire from="(250,100)" to="(250,130)"/>
    <wire from="(250,130)" to="(350,130)"/>
    <wire from="(100,200)" to="(210,200)"/>
    <wire from="(240,200)" to="(300,200)"/>
    <wire from="(300,200)" to="(300,170)"/>
    <wire from="(300,170)" to="(350,170)"/>
    <wire from="(400,150)" to="(500,150)"/>
  </circuit>
</project>
